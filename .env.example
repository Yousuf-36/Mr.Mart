# -------------------------------------------------------
# Mr. Mart — Environment Variables
# Copy this to .env and fill in real values.
# NEVER commit the filled-in .env to source control.
# See docs/05 Security & Compliance, Section 5.
# -------------------------------------------------------

# ----- PostgreSQL -----
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=mrmart
POSTGRES_USER=mrmart
POSTGRES_PASSWORD=changeme_dev_only

DATABASE_URL=postgresql://mrmart:changeme_dev_only@localhost:5432/mrmart

# ----- Redis -----
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ----- MCP Server (packages/mcp-server) -----
MCP_PORT=3333

# ----- Backend (apps/backend) -----
BACKEND_PORT=3001
NODE_ENV=development

# ----- Worker (apps/worker) -----
# Inherits DATABASE_URL and REDIS_* above

# ----- External APIs (leave blank in dev — used in staging/prod only) -----
# WHATSAPP_API_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# STRIPE_SECRET_KEY=
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=

# ----- Auth (used from Stage 2 onward) -----
# JWT_SECRET=
# JWT_EXPIRY=1h
# REFRESH_TOKEN_EXPIRY=30d
