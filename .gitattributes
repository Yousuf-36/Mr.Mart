# Normalize line endings to LF in the repo (checkout as-is on Windows if autocrlf is set)
* text=auto eol=lf

# Binary files — never convert
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
*.otf binary
*.mp4 binary
*.webp binary
*.pptx binary
*.xlsx binary
*.zip binary
